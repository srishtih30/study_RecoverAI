# ============================================
# Environment variables
# ============================================
.env
.env.local
.env.*.local

backend/.env
frontend/.env

# Keep example environment files
!.env.example
!backend/.env.example
!frontend/.env.example


# ============================================
# Python / Backend
# ============================================

# Virtual environments
backend/.venv/
backend/venv/
backend/env/
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Pytest
.pytest_cache/
backend/.pytest_cache/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Type checking / linting caches
.mypy_cache/
.ruff_cache/
.pyright/

# Python packaging
build/
dist/
*.egg-info/
.eggs/

# Alembic generated caches
backend/alembic/**/__pycache__/


# ============================================
# Node / Frontend
# ============================================

# Dependencies
frontend/node_modules/
node_modules/

# Vite build output
frontend/dist/

# TypeScript build cache
*.tsbuildinfo

# Vite cache
.vite/
frontend/.vite/

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


