# Copy this file to backend/.env and fill in real values for local development.
# Never commit the real .env file. Never expose these to the frontend.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins (CORS).
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Database (Postgres, see docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg2://recoverai:recoverai@localhost:5432/recoverai

# --- Redis / Celery (see docker-compose.yml) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Razorpay (TEST MODE ONLY — never put live keys here) ---
# TODO(AG): verify Razorpay test-mode behavior for webhook + subscription APIs.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- LLM fallback classifier (optional) ---
# LLM_PROVIDER: "none" disables the fallback entirely (deterministic-only).
# Set to "anthropic" or "openai" once a real provider is wired in
# app/integrations/llm/classifier_fallback.py (currently a stub — see
# TODO(AG) markers there).
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# --- Recovery defaults (fallback values; stopping_rules_config table is the
# real source of truth once seeded — see app/models/stopping_rule.py) ---
DEFAULT_MAX_RETRY_ATTEMPTS=3
DEFAULT_MAX_DAYS_OPEN=7
